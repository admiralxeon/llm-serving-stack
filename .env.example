# Copy to .env and change the values. .env is git-ignored.

# Key vLLM requires on every request. Only LiteLLM should know it (Step 2).
VLLM_API_KEY=change-me-vllm

# Fraction of TOTAL VRAM vLLM may claim. Startup fails if this exceeds the free VRAM (6.96 of 8 GiB here).
VLLM_GPU_MEM=0.60

# Admin key for LiteLLM (must start with sk-). Only used to create/revoke app keys.
LITELLM_MASTER_KEY=sk-master-change-me
# Encrypts credentials LiteLLM stores in Postgres. Set once, never change.
LITELLM_SALT_KEY=sk-salt-change-me
POSTGRES_PASSWORD=change-me-postgres

# Grafana admin login (user: admin).
GRAFANA_PASSWORD=change-me-grafana

# LiteLLM key for the RAG app. Create it with POST /key/generate (see README).
RAG_LITELLM_KEY=sk-change-me-rag
# Requests allowed inside /ask at once; above this the app returns 429.
RAG_MAX_IN_FLIGHT=16
