# Copy to .env and change the values. .env is git-ignored.

# Key vLLM requires on every request. Only LiteLLM should know it (Step 2).
VLLM_API_KEY=change-me-vllm

# Fraction of TOTAL VRAM vLLM may claim. 0.60 because Windows already uses ~2.5 GB of the 8 GB.
VLLM_GPU_MEM=0.60

# Admin key for LiteLLM (must start with sk-). Only used to create/revoke app keys.
LITELLM_MASTER_KEY=sk-master-change-me
# Encrypts credentials LiteLLM stores in Postgres. Set once, never change.
LITELLM_SALT_KEY=sk-salt-change-me
POSTGRES_PASSWORD=change-me-postgres
